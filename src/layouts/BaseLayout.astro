---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BLOG_CONFIG } from "../config";
import "../styles/global.css";
---

<!doctype html>
<html lang={BLOG_CONFIG.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={BLOG_CONFIG.description} />
    <title>{BLOG_CONFIG.title}</title>
    <!-- KaTeX CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6xfEVsEj4gI6+yEKlcAnHK8T4DMmIi8AScAJYkO4nQqJbn4p+tSxtsVpHG"
      crossorigin="anonymous"
    />
    <!-- 学术风字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Pretext 文本排版：预测量文章高度，防止字体加载期间的 CLS -->
    <script src="../scripts/text-layout.ts"></script>
  </body>
</html>
