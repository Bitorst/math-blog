{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "heroImage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "uri"
        }
      ]
    },
    "showHeroImage": {
      "default": true,
      "type": "boolean"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments": {
      "default": true,
      "type": "boolean"
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "toc": {
          "type": "boolean"
        },
        "relatedPosts": {
          "type": "boolean"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date"
  ]
}